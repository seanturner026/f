#!/bin/sh
# Deploy f (binary, Claude Code mod, statusline, nvim f.lua) after each commit or pull on
# main, in the background so the commit doesn't wait. Log: $TMPDIR/f-deploy.log
[ "$(git rev-parse --abbrev-ref HEAD)" = main ] || exit 0
command -v just >/dev/null || exit 0
root=$(git rev-parse --show-toplevel)
(cd "$root" && nohup just deploy >>"${TMPDIR:-/tmp}/f-deploy.log" 2>&1 &)
